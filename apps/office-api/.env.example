PORT=4100
# Address to listen on; 127.0.0.1 when a reverse proxy on the same server is the only way in (empty = all addresses)
HOST=
# Reverse proxies allowed to report the client address and scheme (X-Forwarded-For / X-Forwarded-Proto).
# Empty = none (systemd install with nothing in front). A number = proxy hops (Docker: 1, the office-web nginx).
# Or their addresses / CIDR ranges, comma separated, e.g. 127.0.0.1 for Caddy or nginx on the same server. Never "true".
TRUST_PROXY=
# true once users reach the system over HTTPS: sign-in is then refused over plain HTTP and HSTS is sent
PUBLIC_HTTPS=false
# HSTS lifetime in seconds (start short, raise to 31536000 once HTTPS is stable), or off
HSTS_MAX_AGE=86400
HSTS_INCLUDE_SUBDOMAINS=false
DATABASE_URL=postgres://kx:kx@localhost:5432/kx_office
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-with-a-long-random-secret
# AES-256 key for files and secrets at rest (64 hex chars, required in production): openssl rand -hex 32
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5174
# Address of the web app; QR codes on letters point to $PUBLIC_URL/verify/<tracking code>
PUBLIC_URL=http://localhost:5174
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# Roles that must enable two-factor authentication (comma separated role keys), e.g. admin,president
MFA_REQUIRED_ROLES=
# log | kavenegar
SMS_PROVIDER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# log | smtp   (SMTP_URL=smtp://user:pass@mail.example.ir:587)
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM=اتوماسیون اداری <no-reply@chamber.local>
# Job queue worker (notifications, integration events, feedback) and scheduler (SLA reminders, escalation, retention)
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=5
SCHEDULER_INTERVAL_SECONDS=300
# First administrator on an empty database (when demo data is not loaded). Password: at least 12 characters, not the
# demo one. Prefer `node dist/db/create-admin.js` (password on standard input) so it stays out of the environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Serve the built web app from this process (single port)
WEB_DIST_DIR=
