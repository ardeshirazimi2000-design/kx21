PORT=4000
DATABASE_URL=postgres://kx:kx@localhost:5432/kx
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# log | kavenegar (SMS) ; log | smtp (email) ; log | expo (push)
SMS_PROVIDER=log
EMAIL_PROVIDER=log
PUSH_PROVIDER=expo
SCHEDULER_INTERVAL_SECONDS=300
# National identity inquiry (استعلام هویت ثبت احوال): sapi | mock | none
IDENTITY_PROVIDER=none
IDENTITY_API_URL=https://s.api.ir/api/sw1/PersonInfo
IDENTITY_API_TOKEN=
# true = every new person must be verified with national code + birth date
IDENTITY_REQUIRED=false
# Built-in webinar (Jitsi Meet on its own domain; see deploy/webinar/README.md).
# Leave WEBINAR_URL empty to use only external links (Skyroom, Google Meet, …).
WEBINAR_URL=
WEBINAR_APP_ID=kx-commissions
WEBINAR_APP_SECRET=
WEBINAR_EARLY_MINUTES=30
