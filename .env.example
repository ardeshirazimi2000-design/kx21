# Copy to .env (or export) — every variable is optional in development.
PORT=3000
NODE_ENV=development            # production: hides OTP codes, requires MASTER_SECRET
MASTER_SECRET=change-me         # root secret for JWT / envelope-encryption keys (use KMS/Vault in prod)
DB_PATH=data/telehealth.db
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
SEED=true                       # demo doctors, staff and a rolling 7-day calendar

# Self-hosted LLM (vLLM / any OpenAI-compatible endpoint). Empty = grounded templates.
LLM_BASE_URL=
LLM_MODEL=llama-3.1-8b-instruct
LLM_API_KEY=
LLM_TIMEOUT_MS=8000

# Media server for video/audio visits. Empty = text-chat visits.
LIVEKIT_URL=
ENFORCE_JOIN_WINDOW=false       # true: room opens 15 min before the slot
STREAM_DELAY_MS=12
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost   # native app WebViews
