# Copy to .env (or export) — every variable is optional in development.
PORT=3000
NODE_ENV=development            # production: hides OTP codes, requires MASTER_SECRET
MASTER_SECRET=change-me         # root secret for JWT / envelope-encryption keys (use KMS/Vault in prod)
DB_PATH=data/telehealth.db
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
SEED=true                       # demo doctors, staff and a rolling 7-day calendar

# Self-hosted LLM (vLLM / any OpenAI-compatible endpoint). Empty = grounded templates.
LLM_BASE_URL=
LLM_MODEL=llama-3.1-8b-instruct
LLM_API_KEY=
LLM_TIMEOUT_MS=8000

# Media server for video/audio visits. Empty = text-chat visits.
LIVEKIT_URL=
ENFORCE_JOIN_WINDOW=false       # true: room opens 15 min before the slot
STREAM_DELAY_MS=12
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost   # native app WebViews

# Video visits (WebRTC, peer-to-peer). The installer sets these up with coturn automatically.
TURN_URLS=                      # e.g. turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_SECRET=                    # coturn static-auth-secret (use-auth-secret)
STUN_URLS=stun:stun.l.google.com:19302

# Registration identity checks (s.api.ir). Without a token: mock in development, refused in production.
SAPI_TOKEN=
SAPI_BASE=https://s.api.ir/api/sw1
IDENTITY_INQUIRY_URL=           # optional: default ${SAPI_BASE}/PersonInfo (civil registry name check by national code + birth date)

# Payments — ZarinPal v4 (amounts in Rial). Without a merchant id, development uses a mock gateway.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PUBLIC_BASE_URL=                # e.g. https://clinic.example.ir — used for the gateway callback URL

# Uploaded files (encrypted at rest); defaults to <DB_PATH dir>/files
FILES_DIR=
# Optional self-hosted vision model (OpenAI-compatible) for the doctor's AI pre-read of images
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=qwen2.5-vl-7b-instruct

# Iranian drug directory (reference for prescribers; only drug names are sent), e.g.:
DRUG_API_BASE=
DRUG_API_TOKEN=

# Real registration / login (production): one-time codes by SMS through an approved template.
# Kavenegar: SMS_OTP_TEMPLATE = template name; SMS.ir: template id (+ SMS_TEMPLATE_PARAM, default Code).
SMS_PROVIDER=            # kavenegar | smsir | apiir (api.ir SmsOTP with SAPI_TOKEN; SMS_APIIR_SERVICE=CallOTP for a voice call)
SMS_API_KEY=
SMS_OTP_TEMPLATE=
SMS_MFA_TEMPLATE=        # optional, second-step template (defaults to SMS_OTP_TEMPLATE)
SMS_SENDER=              # optional line number for notification texts
ADMIN_PHONE=             # real administrator mobile (production disables the demo accounts)
