NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://crisis:CHANGE_ME@localhost:5432/crisis
TRUST_PROXY=true
CORS_ORIGINS=

# Run migrations with the schema owner (`npm run migrate`); serve with a DML-only role (docs/guide-preparative.md)
MIGRATE_ON_START=false
DATABASE_SSL=verify-full
DATABASE_SSL_CA_FILE=

# Secrets — independent, at least 32 random characters each (e.g. `openssl rand -base64 48`)
JWT_SECRET=
OTP_PEPPER=
AUDIT_KEY=
INTEGRITY_KEY=
AUDIT_FALLBACK_FILE=/var/lib/crisis/audit-fallback.jsonl
TIME_ZONE=Asia/Tehran

# Trusted path: HTTPS only. Either a TLS-terminating proxy (TRUST_PROXY=true) or the built-in TLS server below.
REQUIRE_HTTPS=true
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional mutual TLS for the console
TLS_CLIENT_CA_FILE=
TLS_CLIENT_CRL_FILE=
TLS_REQUIRE_CLIENT_CERT_CONSOLE=false

# api.ir gateway: Shahkar + SMS OTP (token from the api.ir developer panel)
APIIR_MODE=live
APIIR_BASE_URL=https://s.api.ir
APIIR_TOKEN=
APIIR_SHAHKAR_ENDPOINT=ShahkarPro
APIIR_OTP_TEMPLATE=1

# Defaults only — these and the other security settings are managed at runtime from the console (FMT_SMF)
SHAHKAR_REVERIFY_DAYS=180
SHAHKAR_ON_NEW_DEVICE=true
APP_CITIZEN_SIGNUP=true

# First security administrator (used once by `npm run seed`)
BOOTSTRAP_ADMIN_NATIONAL_CODE=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_USERNAME=secadmin
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
